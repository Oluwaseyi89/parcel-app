# Origin of parcel-app-service (server-only). The browser calls /api/v1/* on this app's own
# origin and Next.js proxies those requests here, so session cookies stay first-party.
# Required for production builds, e.g. https://parcel-app-service.onrender.com
BACKEND_API_URL=http://localhost:7000

# Payment service origin used by the browser. Required for production builds.
NEXT_PUBLIC_PAYMENT_API_BASE=http://localhost:8080

# Optional: call the backend directly instead of through the proxy. Leave unset in production;
# direct calls make session cookies cross-site, which browsers increasingly block.
# NEXT_PUBLIC_API_BASE=
